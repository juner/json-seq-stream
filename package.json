{
  "name": "json-seq-stream",
  "version": "2.0.0",
  "description": "application/json-seq and jsonl (NDJSON) support stream / async iterator library",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rfc7464": {
      "types": "./dist/rfc7464.d.ts",
      "default": "./dist/rfc7464.js"
    },
    "./jsonlines": {
      "types": "./dist/jsonlines.d.ts",
      "default": "./dist/jsonlines.js"
    }
  },
  "scripts": {
    "test:watch": "vitest watch --coverage",
    "test": "vitest run --coverage --coverage.reporter=cobertura --coverage.reporter=text",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "build": "vite build && tsc --project tsconfig.build.json",
    "clean": "node utils/remove.ts -- -f ./dist -f ./TestResults"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juner/json-seq-stream.git"
  },
  "keywords": [
    "application/json-seq",
    "application/jsonl",
    "application/x-ndjson",
    "TransformStream",
    "web streams",
    "asyncIterator",
    "Symbol.asyncIterator",
    "rfc7464",
    "json-seq",
    "jsonl",
    "ndjson",
    "jsonlines"
  ],
  "author": "juners",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/juner/json-seq-stream/issues"
  },
  "homepage": "https://github.com/juner/json-seq-stream#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
